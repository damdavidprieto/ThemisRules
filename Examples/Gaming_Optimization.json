{
    "Meta": {
        "Name": "Gaming optimization",
        "Version": "1.1.0",
        "Author": "ThemisRules",
        "Description": "Current-user settings for gaming. Every rule is reversible."
    },
    "RegistryRules": [
        {
            "ID": "GAME-REG-001",
            "Name": "Disable background game recording (Game DVR)",
            "MacroLevel": "L1",
            "Path": "HKCU:\\System\\GameConfigStore",
            "ValueName": "GameDVR_Enabled",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "GAME-REG-002",
            "Name": "Enable Game Mode",
            "MacroLevel": "L1",
            "Path": "HKCU:\\Software\\Microsoft\\GameBar",
            "ValueName": "AutoGameModeEnabled",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "GAME-REG-003",
            "Name": "Disable the Game Bar tips",
            "MacroLevel": "L2",
            "Path": "HKCU:\\Software\\Microsoft\\GameBar",
            "ValueName": "ShowStartupPanel",
            "Value": 0,
            "Type": "DWord"
        }
    ]
}
