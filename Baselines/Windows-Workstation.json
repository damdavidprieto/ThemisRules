    "SecurityPolicyRules": [
        {
            "ID": "WIN-ACC-001",
            "MacroLevel": "L1",
            "Name": "Password history: 24 passwords or more",
            "Key": "PasswordHistorySize",
            "Value": 24,
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-ACC-002",
            "MacroLevel": "L1",
            "Name": "Minimum password age: 1 day or more",
            "Key": "MinimumPasswordAge",
            "Value": 1,
            "Comparison": "AtLeast",
            "Description": "Stops users from cycling through the history to reuse a password."
        },
        {
            "ID": "WIN-ACC-003",
            "MacroLevel": "L1",
            "Name": "Minimum password length: 14 characters or more",
            "Key": "MinimumPasswordLength",
            "Value": 14,
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-ACC-004",
            "MacroLevel": "L1",
            "Name": "Passwords must meet complexity requirements",
            "Key": "PasswordComplexity",
            "Value": 1
        },
        {
            "ID": "WIN-ACC-005",
            "MacroLevel": "L1",
            "Name": "Do not store passwords with reversible encryption",
            "Key": "ClearTextPassword",
            "Value": 0
        },
        {
            "ID": "WIN-ACC-006",
            "MacroLevel": "L1",
            "Name": "Account lockout threshold: 1 to 10 failed attempts",
            "Key": "LockoutBadCount",
            "Value": 10,
            "Comparison": "Between",
            "Min": 1,
            "Max": 10,
            "Description": "0 means accounts never lock, which allows unlimited password guessing."
        },
        {
            "ID": "WIN-ACC-007",
            "MacroLevel": "L1",
            "Name": "Account lockout duration: 15 minutes or more",
            "Key": "LockoutDuration",
            "Value": 15,
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-ACC-008",
            "MacroLevel": "L1",
            "Name": "Reset the failed-logon counter after 15 minutes or more",
            "Key": "ResetLockoutCount",
            "Value": 15,
            "Comparison": "AtLeast"
        },
