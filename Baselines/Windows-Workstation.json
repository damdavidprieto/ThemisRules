{
    "Meta": {
        "Name": "Windows workstation baseline",
        "Version": "1.0.0",
        "Author": "ThemisRules",
        "AppliesTo": "Windows 10 and Windows 11, standalone or workgroup machines. On domain-joined machines Group Policy usually defines these settings: use the baseline to audit them.",
        "Description": "Security settings commonly recommended by the Microsoft Security Baselines and the CIS Benchmarks for Windows. L1: safe for any machine. L2: stronger, may affect compatibility or convenience. L3: high security, turns features off. Audit first, then enforce level by level.",
        "References": [
            "https://learn.microsoft.com/windows/security/operating-system-security/device-management/windows-security-configuration-framework/windows-security-baselines",
            "https://www.cisecurity.org/benchmark/microsoft_windows_desktop"
        ]
    },
    "RegistryRules": [
        {
            "ID": "WIN-UAC-001",
            "MacroLevel": "L1",
            "Name": "UAC: run all administrators in Admin Approval Mode",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "EnableLUA",
            "Value": 1,
            "Type": "DWord",
            "Description": "Turning UAC off runs every program with full administrator rights.",
            "Default": 1
        },
        {
            "ID": "WIN-UAC-002",
            "MacroLevel": "L1",
            "Name": "UAC: prompt administrators for consent on the secure desktop",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "ConsentPromptBehaviorAdmin",
            "Value": 2,
            "Type": "DWord"
        },
        {
            "ID": "WIN-UAC-003",
            "MacroLevel": "L1",
            "Name": "UAC: show elevation prompts on the secure desktop",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "PromptOnSecureDesktop",
            "Value": 1,
            "Type": "DWord",
            "Description": "Other programs cannot see or click the prompt.",
            "Default": 1
        },
        {
            "ID": "WIN-UAC-004",
            "MacroLevel": "L1",
            "Name": "UAC: Admin Approval Mode for the built-in Administrator",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "FilterAdministratorToken",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-UAC-005",
            "MacroLevel": "L1",
            "Name": "UAC: restrict local administrator accounts on network logons",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "LocalAccountTokenFilterPolicy",
            "Value": 0,
            "Type": "DWord",
            "Description": "Limits pass-the-hash with local administrator accounts.",
            "Default": 0
        },
        {
            "ID": "WIN-UAC-006",
            "MacroLevel": "L2",
            "Name": "UAC: deny elevation requests from standard users",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "ConsentPromptBehaviorUser",
            "Value": 0,
            "Type": "DWord",
            "Description": "Standard users cannot type administrator credentials into a prompt; administrators log on to elevate."
        },
        {
            "ID": "WIN-SYS-001",
            "MacroLevel": "L1",
            "Name": "Lock the session after at most 15 minutes of inactivity",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "ValueName": "InactivityTimeoutSecs",
            "Value": 900,
            "Type": "DWord",
            "Comparison": "Between",
            "Min": 1,
            "Max": 900,
            "Description": "0 means the session never locks."
        },
        {
            "ID": "WIN-SYS-002",
            "MacroLevel": "L1",
            "Name": "Disable automatic logon",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
            "ValueName": "AutoAdminLogon",
            "Value": "0",
            "Type": "String",
            "Description": "Automatic logon stores the password in the registry.",
            "Default": "0"
        },
        {
            "ID": "WIN-CRED-001",
            "MacroLevel": "L1",
            "Name": "Do not keep plain-text passwords in memory (WDigest)",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest",
            "ValueName": "UseLogonCredential",
            "Value": 0,
            "Type": "DWord",
            "Default": 0
        },
        {
            "ID": "WIN-CRED-002",
            "MacroLevel": "L1",
            "Name": "Send NTLMv2 responses only; refuse LM and NTLM",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "LmCompatibilityLevel",
            "Value": 5,
            "Type": "DWord"
        },
        {
            "ID": "WIN-CRED-003",
            "MacroLevel": "L1",
            "Name": "Do not store LAN Manager password hashes",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "NoLMHash",
            "Value": 1,
            "Type": "DWord",
            "Default": 1
        },
        {
            "ID": "WIN-CRED-004",
            "MacroLevel": "L1",
            "Name": "Block anonymous enumeration of SAM accounts",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "RestrictAnonymousSAM",
            "Value": 1,
            "Type": "DWord",
            "Default": 1
        },
        {
            "ID": "WIN-CRED-005",
            "MacroLevel": "L1",
            "Name": "Block anonymous enumeration of SAM accounts and shares",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "RestrictAnonymous",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-CRED-006",
            "MacroLevel": "L1",
            "Name": "Do not apply Everyone permissions to anonymous users",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "EveryoneIncludesAnonymous",
            "Value": 0,
            "Type": "DWord",
            "Default": 0
        },
        {
            "ID": "WIN-CRED-007",
            "MacroLevel": "L1",
            "Name": "Only administrators may query the SAM remotely",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "RestrictRemoteSAM",
            "Value": "O:BAG:BAD:(A;;RC;;;BA)",
            "Type": "String"
        },
        {
            "ID": "WIN-CRED-008",
            "MacroLevel": "L1",
            "Name": "Blank passwords only work for console logons",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "LimitBlankPasswordUse",
            "Value": 1,
            "Type": "DWord",
            "Default": 1
        },
        {
            "ID": "WIN-CRED-009",
            "MacroLevel": "L2",
            "Name": "Run LSA as a protected process",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "RunAsPPL",
            "Value": 1,
            "Type": "DWord",
            "Description": "Protects credentials in LSASS memory. Some third-party authentication plug-ins must be signed to keep working."
        },
        {
            "ID": "WIN-NET-001",
            "MacroLevel": "L1",
            "Name": "Disable SMBv1 on the SMB server",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
            "ValueName": "SMB1",
            "Value": 0,
            "Type": "DWord",
            "Description": "SMBv1 was the vector of WannaCry and NotPetya."
        },
        {
            "ID": "WIN-NET-002",
            "MacroLevel": "L1",
            "Name": "SMB server: always sign communications",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
            "ValueName": "RequireSecuritySignature",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-NET-003",
            "MacroLevel": "L1",
            "Name": "SMB client: always sign communications",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
            "ValueName": "RequireSecuritySignature",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-NET-004",
            "MacroLevel": "L1",
            "Name": "SMB client: never send unencrypted passwords to third-party servers",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
            "ValueName": "EnablePlainTextPassword",
            "Value": 0,
            "Type": "DWord",
            "Default": 0
        },
        {
            "ID": "WIN-NET-005",
            "MacroLevel": "L1",
            "Name": "Turn off multicast name resolution (LLMNR)",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
            "ValueName": "EnableMulticast",
            "Value": 0,
            "Type": "DWord",
            "Description": "LLMNR answers can be spoofed on the local network to capture credentials."
        },
        {
            "ID": "WIN-NET-006",
            "MacroLevel": "L2",
            "Name": "NetBIOS name resolution: query WINS only (P-node)",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters",
            "ValueName": "NodeType",
            "Value": 2,
            "Type": "DWord",
            "Description": "Stops NetBIOS broadcast queries, which can be spoofed."
        },
        {
            "ID": "WIN-RDP-001",
            "MacroLevel": "L1",
            "Name": "Remote Desktop: require Network Level Authentication",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services",
            "ValueName": "UserAuthentication",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-RDP-002",
            "MacroLevel": "L1",
            "Name": "Remote Desktop: high encryption level",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services",
            "ValueName": "MinEncryptionLevel",
            "Value": 3,
            "Type": "DWord"
        },
        {
            "ID": "WIN-RDP-003",
            "MacroLevel": "L1",
            "Name": "Turn off solicited Remote Assistance",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services",
            "ValueName": "fAllowToGetHelp",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "WIN-RDP-004",
            "MacroLevel": "L2",
            "Name": "Remote Desktop: always prompt for the password",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services",
            "ValueName": "fPromptForPassword",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-WRM-001",
            "MacroLevel": "L1",
            "Name": "WinRM client: no Basic authentication",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WinRM\\Client",
            "ValueName": "AllowBasic",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "WIN-WRM-002",
            "MacroLevel": "L1",
            "Name": "WinRM client: no unencrypted traffic",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WinRM\\Client",
            "ValueName": "AllowUnencryptedTraffic",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "WIN-WRM-003",
            "MacroLevel": "L1",
            "Name": "WinRM service: no Basic authentication",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WinRM\\Service",
            "ValueName": "AllowBasic",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "WIN-WRM-004",
            "MacroLevel": "L1",
            "Name": "WinRM service: no unencrypted traffic",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WinRM\\Service",
            "ValueName": "AllowUnencryptedTraffic",
            "Value": 0,
            "Type": "DWord"
        },
        {
            "ID": "WIN-MAL-001",
            "MacroLevel": "L1",
            "Name": "Turn off AutoPlay on all drives",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
            "ValueName": "NoDriveTypeAutoRun",
            "Value": 255,
            "Type": "DWord"
        },
        {
            "ID": "WIN-MAL-002",
            "MacroLevel": "L1",
            "Name": "Do not run AutoRun commands",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
            "ValueName": "NoAutorun",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-MAL-003",
            "MacroLevel": "L1",
            "Name": "Windows Installer: never install with elevated privileges",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer",
            "ValueName": "AlwaysInstallElevated",
            "Value": 0,
            "Type": "DWord",
            "Description": "Otherwise any user can install an MSI package as SYSTEM.",
            "Default": 0
        },
        {
            "ID": "WIN-MAL-004",
            "MacroLevel": "L1",
            "Name": "Microsoft Defender: block potentially unwanted applications",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender",
            "ValueName": "PUAProtection",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-MAL-005",
            "MacroLevel": "L1",
            "Name": "SmartScreen for apps and files: enabled",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
            "ValueName": "EnableSmartScreen",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-MAL-006",
            "MacroLevel": "L1",
            "Name": "SmartScreen: warn and prevent bypass",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
            "ValueName": "ShellSmartScreenLevel",
            "Value": "Block",
            "Type": "String"
        },
        {
            "ID": "WIN-MAL-007",
            "MacroLevel": "L3",
            "Name": "Turn off Windows Script Host",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows Script Host\\Settings",
            "ValueName": "Enabled",
            "Value": 0,
            "Type": "DWord",
            "Description": "Blocks .vbs and .js scripts, a common malware vector. Breaks logon scripts and tools that use them."
        },
        {
            "ID": "WIN-LOG-001",
            "MacroLevel": "L1",
            "Name": "Include the command line in process creation events",
            "Path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Audit",
            "ValueName": "ProcessCreationIncludeCmdLine_Enabled",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-LOG-002",
            "MacroLevel": "L1",
            "Name": "Use the advanced audit policy subcategories",
            "Path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
            "ValueName": "SCENoApplyLegacyAuditPolicy",
            "Value": 1,
            "Type": "DWord",
            "Description": "Without it, legacy category settings can override the AuditPolicyRules of this baseline."
        },
        {
            "ID": "WIN-LOG-003",
            "MacroLevel": "L1",
            "Name": "PowerShell script block logging",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging",
            "ValueName": "EnableScriptBlockLogging",
            "Value": 1,
            "Type": "DWord"
        },
        {
            "ID": "WIN-LOG-004",
            "MacroLevel": "L2",
            "Name": "PowerShell transcription",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\Transcription",
            "ValueName": "EnableTranscripting",
            "Value": 1,
            "Type": "DWord",
            "Description": "Records every PowerShell session to text files in the user documents folder."
        },
        {
            "ID": "WIN-LOG-005",
            "MacroLevel": "L1",
            "Name": "Security event log size: 192 MB or more",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\EventLog\\Security",
            "ValueName": "MaxSize",
            "Value": 196608,
            "Type": "DWord",
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-LOG-006",
            "MacroLevel": "L1",
            "Name": "Application event log size: 32 MB or more",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\EventLog\\Application",
            "ValueName": "MaxSize",
            "Value": 32768,
            "Type": "DWord",
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-LOG-007",
            "MacroLevel": "L1",
            "Name": "System event log size: 32 MB or more",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\EventLog\\System",
            "ValueName": "MaxSize",
            "Value": 32768,
            "Type": "DWord",
            "Comparison": "AtLeast"
        },
        {
            "ID": "WIN-PRV-001",
            "MacroLevel": "L2",
            "Name": "Diagnostic data: required only",
            "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
            "ValueName": "AllowTelemetry",
            "Value": 1,
            "Type": "DWord",
            "Comparison": "AtMost"
        }
    ],
