{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ThemisRules Policy",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "Meta": {
            "type": "object",
            "required": [
                "Name",
                "Version"
            ],
            "properties": {
                "Name": {
                    "type": "string"
                },
                "Version": {
                    "type": "string"
                },
                "Author": {
                    "type": "string"
                },
                "Description": {
                    "type": "string"
                },
                "AppliesTo": {
                    "type": "string"
                },
                "Created": {
                    "type": "string"
                },
                "References": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "SourcePolicy": {
                    "type": "string",
                    "description": "In backups: the policy whose Enforce run saved them."
                }
            }
        },
        "RegistryRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Path",
                    "ValueName"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "Path": {
                        "type": "string",
                        "description": "Registry key, such as HKLM:\\SOFTWARE\\... Must be a registry path."
                    },
                    "ValueName": {
                        "type": "string"
                    },
                    "Value": {
                        "type": [
                            "string",
                            "integer",
                            "number",
                            "array"
                        ]
                    },
                    "Type": {
                        "type": "string",
                        "enum": [
                            "Binary",
                            "DWord",
                            "ExpandString",
                            "MultiString",
                            "QWord",
                            "String"
                        ]
                    },
                    "Default": {
                        "type": [
                            "string",
                            "integer",
                            "number"
                        ],
                        "description": "Value Windows uses when the registry value is not set. If it meets the rule, a missing value is compliant."
                    },
                    "Ensure": {
                        "type": "string",
                        "enum": [
                            "Absent"
                        ],
                        "description": "Absent: the value must not exist (Enforce removes it). Used by backups."
                    },
                    "Comparison": {
                        "type": "string",
                        "enum": [
                            "Equal",
                            "AtLeast",
                            "AtMost",
                            "Between",
                            "In"
                        ]
                    },
                    "Min": {
                        "type": "number"
                    },
                    "Max": {
                        "type": "number"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    },
                    "WriteValue": {
                        "description": "What Enforce writes when it differs from Value (needed for Between and In)."
                    },
                    "MatchValue": {
                        "description": "With Ensure = Absent: only this value is removed."
                    },
                    "RemoveKeyIfEmpty": {
                        "type": "boolean",
                        "description": "In backups: remove the key when it is left empty."
                    }
                }
            }
        },
        "ServiceRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "State": {
                        "type": "string",
                        "enum": [
                            "Running",
                            "Stopped"
                        ]
                    },
                    "StartupType": {
                        "type": "string",
                        "enum": [
                            "Automatic",
                            "Manual",
                            "Disabled"
                        ]
                    },
                    "Action": {
                        "type": "string",
                        "enum": [
                            "Absent"
                        ],
                        "description": "Absent deletes the service in Enforce mode."
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    },
                    "AllowStricter": {
                        "type": "boolean",
                        "description": "Accept a stricter startup type (Disabled meets Manual)."
                    }
                }
            }
        },
        "ProcessRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "State"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "State": {
                        "type": "string",
                        "enum": [
                            "Absent",
                            "Present"
                        ]
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    }
                }
            }
        },
        "AuditPolicyRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Subcategory",
                    "Setting"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "Subcategory": {
                        "type": "string",
                        "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$",
                        "description": "Advanced audit policy subcategory GUID (auditpol /list /subcategory:* /v)."
                    },
                    "Setting": {
                        "type": "string",
                        "enum": [
                            "Success",
                            "Failure",
                            "SuccessAndFailure",
                            "NoAuditing"
                        ]
                    },
                    "Exact": {
                        "type": "boolean",
                        "description": "Require exactly this setting instead of at least it. Used by backups."
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    }
                }
            }
        },
        "UserRightsRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Right",
                    "Principals"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "Right": {
                        "type": "string",
                        "pattern": "^Se[A-Za-z]+(Privilege|Right)$",
                        "description": "User right constant, such as SeDebugPrivilege."
                    },
                    "Principals": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "^S-1-[0-9]+(-[0-9]+)+$"
                        },
                        "description": "SIDs, such as S-1-5-32-544 for Administrators. Names are not accepted."
                    },
                    "Comparison": {
                        "type": "string",
                        "enum": [
                            "Equal",
                            "Includes",
                            "Excludes"
                        ],
                        "default": "Equal"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    }
                }
            }
        },
        "SecurityPolicyRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Key",
                    "Value"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "Key": {
                        "type": "string",
                        "enum": [
                            "MinimumPasswordAge",
                            "MaximumPasswordAge",
                            "MinimumPasswordLength",
                            "PasswordComplexity",
                            "PasswordHistorySize",
                            "LockoutBadCount",
                            "ResetLockoutCount",
                            "LockoutDuration",
                            "AllowAdministratorLockout",
                            "RequireLogonToChangePassword",
                            "ForceLogoffWhenHourExpire",
                            "ClearTextPassword",
                            "LSAAnonymousNameLookup",
                            "EnableAdminAccount",
                            "EnableGuestAccount"
                        ],
                        "description": "[System Access] setting of the local security policy."
                    },
                    "Value": {
                        "type": "integer"
                    },
                    "Comparison": {
                        "type": "string",
                        "enum": [
                            "Equal",
                            "AtLeast",
                            "AtMost",
                            "Between"
                        ],
                        "default": "Equal",
                        "description": "How the actual value is compared. AtLeast, AtMost and Between need numbers; Between uses Min and Max. Enforce always writes Value."
                    },
                    "Min": {
                        "type": "number"
                    },
                    "Max": {
                        "type": "number"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    }
                }
            }
        },
        "FirewallProfileRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Profile",
                    "Setting",
                    "Value"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "Profile": {
                        "type": "string",
                        "enum": [
                            "Domain",
                            "Private",
                            "Public"
                        ]
                    },
                    "Setting": {
                        "type": "string",
                        "enum": [
                            "Enabled",
                            "DefaultInboundAction",
                            "DefaultOutboundAction",
                            "NotifyOnListen",
                            "LogBlocked",
                            "LogAllowed",
                            "LogMaxSizeKilobytes",
                            "AllowInboundRules",
                            "AllowLocalFirewallRules",
                            "AllowUnicastResponseToMulticast"
                        ]
                    },
                    "Value": {
                        "type": [
                            "string",
                            "integer"
                        ]
                    },
                    "Comparison": {
                        "type": "string",
                        "enum": [
                            "Equal",
                            "AtLeast",
                            "AtMost",
                            "Between"
                        ],
                        "default": "Equal",
                        "description": "How the actual value is compared. AtLeast, AtMost and Between need numbers; Between uses Min and Max. Enforce always writes Value."
                    },
                    "Min": {
                        "type": "number"
                    },
                    "Max": {
                        "type": "number"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    }
                }
            }
        },
        "FeatureRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Feature",
                    "State"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    },
                    "Feature": {
                        "type": "string"
                    },
                    "State": {
                        "type": "string",
                        "enum": [
                            "Enabled",
                            "Disabled"
                        ]
                    }
                }
            }
        },
        "SecureFolderRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Path"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    },
                    "Path": {
                        "type": "string"
                    },
                    "Sddl": {
                        "type": "string"
                    },
                    "Ensure": {
                        "type": "string",
                        "enum": [
                            "Absent"
                        ]
                    }
                }
            }
        },
        "CheckRules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "ID",
                    "Name",
                    "Fact",
                    "Expected"
                ],
                "properties": {
                    "ID": {
                        "type": "string"
                    },
                    "Name": {
                        "type": "string"
                    },
                    "MacroLevel": {
                        "type": "string",
                        "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "L4",
                            "L5"
                        ],
                        "description": "Hardening level. Invoke-ThemisPolicy -MacroLevel Ln evaluates rules up to Ln."
                    },
                    "Description": {
                        "type": "string"
                    },
                    "AppliesIf": {
                        "type": "object",
                        "description": "Conditions on the facts given with -Facts: a value, or {\"lt\"|\"le\"|\"gt\"|\"ge\"|\"eq\"|\"ne\": number}."
                    },
                    "DependsOn": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of earlier rules that must be applicable and compliant first."
                    },
                    "Fact": {
                        "type": "string"
                    },
                    "Expected": {},
                    "Action": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
